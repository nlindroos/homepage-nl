---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} class="text-link">
  <span class="text-link__label"><slot /></span>
  <span class="text-link__arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-primary);
    font-size: 1.125rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .text-link__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .text-link__arrow {
    transition: transform var(--transition);
  }

  .text-link:hover {
    color: var(--color-primary-hover);
  }

  .text-link:hover .text-link__arrow {
    transform: translateX(0.2em);
  }
</style>
