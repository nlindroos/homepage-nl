---
import { experience } from "../data/experience";
---

<section class="experience" aria-labelledby="experience-cards-heading">
  <div class="experience-header">
    <p class="eyebrow">Selected experience</p>
    <h2 id="experience-cards-heading" class="experience-title">Where I've delivered.</h2>
  </div>

  <div class="experience-cards">
    {
      experience.map((item) => (
        <article class="experience-card">
          <p class="experience-period">{item.period}</p>
          <p class="experience-role">
            {item.role} · {item.company}
          </p>
          {item.summary && <p class="experience-summary">{item.summary}</p>}
          {item.description && <p class="experience-description">{item.description}</p>}
          {item.engagements && item.engagements.length > 0 && (
            <ul class="engagements">
              {item.engagements.map((engagement) => (
                <li class="engagement">
                  <p class="engagement-client">{engagement.client}</p>
                  <p class="engagement-detail">{engagement.description}</p>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .experience {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 1110px;
    margin-left: auto;
    margin-right: auto;
  }

  .experience-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .eyebrow {
    font-size: 0.75rem;
    font-family: var(--font-body);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    max-width: none;
  }

  .experience-title {
    font-size: 2.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    max-width: none;
  }

  .experience-cards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .experience-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1 1 calc(50% - (var(--space-lg) / 2));
    padding: var(--space-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-divider);
    border-radius: var(--border-radius);
  }

  .experience-period {
    font-size: 0.6563rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    max-width: none;
  }

  .experience-role {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    max-width: none;
  }

  .experience-summary {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    max-width: none;
  }

  .experience-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    max-width: none;
  }

  .engagements {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-accent);
  }

  .engagement {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .engagement-client {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    max-width: none;
  }

  .engagement-detail {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    max-width: none;
  }

  @media (width <= 768px) {
    .experience-card {
      flex-basis: 100%;
    }
  }
</style>
