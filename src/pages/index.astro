---
import { Image } from "astro:assets";
import cutout from "../assets/cutout.webp";
import { SITE } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <main>
    <div class="hero">
      <div class="hero-text">
        <p class="eyebrow">Volume I — the Person</p>
        <h1>
          <span class="line-white">Deliverer of</span>
          <span class="line-accent">real outcomes.</span>
        </h1>
        <div class="body-copy">
          <p>
            I turn complex needs into software that creates measurable value.
          </p>
          <p>
            As an engineer, I work across product, architecture, and
            infrastructure to shape systems that are scalable, maintainable, and
            aligned with business goals.
          </p>
          <p>
            I bring a broad perspective to technical decision-making:
            understanding ownership priorities, user needs, team dynamics,
            constraints, and the tradeoffs required to move things forward. I
            focus on creating clarity where there is complexity, turning
            competing perspectives into practical decisions that support
            reliability, customer value, and long-term sustainability.
          </p>
          <!-- In an era defined by frantic velocity and fleeting attention, true
            luxury is found in the deliberate pause. We craft digital
            environments that demand reflection, rejecting the noise in favor of
            deep, intentional curation.
          </p>
          <p>
            This is not merely aesthetics; it is an architectural philosophy.
            High contrast, vast expanses of void, and typography that whispers
            rather than shouts. Here, form does not follow function — it
            elevates it into something enduring.
          </p> -->
        </div>
        <!-- <Button href="#">What I have done</Button> -->
      </div>

      <div class="hero-image">
        <Image src={cutout} alt="Portait" class="portrait" />
        <span class="caption fig-caption">Fig 1. Intentionality</span>
      </div>
    </div>
  </main>

  <!-- <footer>
    <p>© 2024 You are here. Curated for the patient eye.</p>
  </footer> -->
</BaseLayout>

<style>
  main {
    padding: var(--space-xl) var(--space-lg);
  }

  .hero {
    display: flex;
    gap: var(--space-xl);
    align-items: center;

    /* max-width: 876px; */
    max-width: 1110px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    flex: 1;
  }

  h1 {
    display: flex;
    flex-direction: column;
    font-size: 2.5rem;
    line-height: 1.05;
    gap: 0;
  }

  .line-white {
    color: var(--color-text-primary);
  }

  .line-accent {
    color: var(--color-accent);
  }

  .body-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .body-copy p {
    max-width: none;
  }

  .hero-image {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
    width: 140px;
  }

  .portrait {
    width: 140px;
    object-fit: cover;
    border: 1px solid var(--color-border);
    display: block;
    border-radius: var(--border-radius);
  }

  .fig-caption {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    padding-left: var(--space-sm);
    align-self: flex-end;
    white-space: nowrap;
  }

  footer {
    padding: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--color-divider);
  }

  footer p {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    max-width: none;
  }

  @media (width <= 768px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-image {
      order: -1;
      width: auto;
    }

    .portrait {
      width: auto;
      height: 180px;
      object-fit: contain;
    }
  }
</style>
